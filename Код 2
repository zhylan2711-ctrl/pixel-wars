<!DOCTYPE html>

<html lang="uk" translate="no">
<head>
    <meta charset="UTF-8">
    <meta name="google" content="notranslate">

    
    <title>Панель керування</title>
    <style>
        body {
            background-color: #0b0e14;
            color: white;
            font-family: sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 50px;
        }
        .card {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 10px;
            border: 1px solid #27ae60;
        }
        button {
            background: #27ae60;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="card">
        <h2>Налаштування</h2>
        <input type="color" id="colorPicker">
        <button onclick="alert('Збережено!')">Зберегти</button>
    </div>
    <br>
    <a href="Код 1" style="color: #27ae60;">⬅ Назад до пікселів</a>
</body>
</html>
